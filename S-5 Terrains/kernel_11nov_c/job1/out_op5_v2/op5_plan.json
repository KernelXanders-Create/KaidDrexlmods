 "approaches": {
  "5-F Acropolis Citadel": [
   "up the road from Kastro Quay past the power station, Windmill Ridge and the Citadel Gate (5-07)",
   "the covered climb from the south-west: past the Olive Terraces Post (5-08) onto the summit's west side"
  ],
  "5-M1 Windmill Ridge": [
   "from the pumice south beach, past (or through) the bunker line (5-01) and up the spine",
   "along the ridge road from the Ridge Power Station (5-05)"
  ],
  "5-M2 Sea Cave Pens": [
   "by boat across the Kastro Strait into the cave mouth",
   "from above: down from the Olive Terraces Post (5-08) on its road or the cliff path"
  ],
  "5-M3 Kastro Quay": [
   "by boat to the quay apron in the cove, then the cargo lift and the stair up the cliff",
   "overland from the East Bay Landers (5-14) or along the road from the power station (5-05)"
  ],
  "5-M4 Lantern Rock Beacon": [
   "by boat to Lantern Quay, then up the hamlet stairs to the beacon",
   "by boat or air to the rock's north and east shores (shores list), then up the slope on foot"
  ]
 },
